generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BillingStatus {
  free
  pro
}

enum StrategyMode {
  referral_first
  speed_first
}

enum ConnectionType {
  alumni
  linkedin_1st
  cold
  recruiter
  other
}

enum OutreachStatus {
  identified
  message_drafted
  message_sent
  responded
  sharing_internally
  referral_requested
  referral_secured
  referral_submitted
  no_response
  declined
}

enum OutreachPlatform {
  linkedin
  email
  other
}

enum InterviewStage {
  interviewing
  offer
  accepted
  rejected
  withdrawn
}

enum TemplateCategory {
  initial_outreach
  follow_up
  thank_you
  referral_request
}

// ---------------------------------------------------------------------------
// NextAuth models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
// NOTE: The following fields have been added and require `prisma db push`:
// - targetRoles String[] (array of job titles/roles)
// - preferredLocations String[] (array of location preferences)
// - remotePreference String? (one of: "remote", "hybrid", "onsite", "no_preference")
// - experienceLevel String? (one of: "entry", "mid", "senior", "executive")

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String
  password_hash     String?
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime      @default(now())
  billingStatus     BillingStatus @default(free)
  stripeCustomerId  String?
  strategyMode      StrategyMode  @default(referral_first)
  stalledDays       Int           @default(5)
  config            Json          @default("{}")
  targetRoles       String[]      @default([])
  preferredLocations String[]     @default([])
  remotePreference  String?
  experienceLevel   String?

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  resumeVersions   ResumeVersion[]
  messageTemplates MessageTemplate[]
  jobs             Job[]
  contacts         Contact[]
  outreachEvents   OutreachEvent[]
  interviews       Interview[]
  savedSearches    SavedSearch[]
}

// ---------------------------------------------------------------------------
// Resume versions
// ---------------------------------------------------------------------------

model ResumeVersion {
  id        String   @id @default(uuid())
  userId    String
  name      String
  content   String?  @db.Text
  fileUrl   String?
  keywords  Json?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([userId, name])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Message templates
// ---------------------------------------------------------------------------

model MessageTemplate {
  id        String           @id @default(uuid())
  userId    String
  name      String
  body      String           @db.Text
  category  TemplateCategory @default(initial_outreach)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

model Job {
  id                 String          @id @default(uuid())
  userId             String
  title              String
  company            String
  location           String?
  remoteType         String?
  salaryMin          Int?
  salaryMax          Int?
  description        String?         @db.Text
  url                String?
  source             String          @default("manual")
  externalId         String?
  datePosted         DateTime?       @db.Date
  applied            Boolean         @default(false)
  appliedAt          DateTime?
  resumeVersionId    String?
  coverLetter        String?         @db.Text
  coverLetterFileUrl String?
  interviewStage     InterviewStage?
  nextAction         String?
  nextActionOverride Boolean         @default(false)
  strategyOverride   StrategyMode?
  notes              String?         @db.Text
  archived           Boolean         @default(false)
  // NOTE: The following fields have been added and require `prisma db push`:
  // - applicationMethod String? (company_website, linkedin_easy_apply, email, recruiter, other)
  // - applicationUrl String?
  applicationMethod  String?
  applicationUrl     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  outreachEvents OutreachEvent[]
  interviews     Interview[]

  @@unique([userId, externalId])
  @@index([userId])
  @@index([userId, archived])
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

model Contact {
  id             String         @id @default(uuid())
  userId         String
  name           String
  title          String?
  company        String?
  linkedinUrl    String?
  email          String?
  connectionType ConnectionType @default(cold)
  school         String?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreachEvents OutreachEvent[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Outreach events
// ---------------------------------------------------------------------------

model OutreachEvent {
  id           String           @id @default(uuid())
  userId       String
  jobId        String
  contactId    String
  status       OutreachStatus   @default(identified)
  statusRank   Int              @default(0)
  messageDraft String?          @db.Text
  messageFinal String?          @db.Text
  platform     OutreachPlatform?
  lastActionAt DateTime         @default(now())
  followUpAt   DateTime?        @db.Date
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, jobId])
  @@index([userId, contactId])
  @@index([userId, status, lastActionAt])
}

// ---------------------------------------------------------------------------
// Interviews
// ---------------------------------------------------------------------------
// NOTE: The following Interview model has been added and requires `prisma db push`:
model Interview {
  id               String    @id @default(cuid())
  jobId            String
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage            String    // phone_screen, technical, behavioral, onsite, final, other
  scheduledAt      DateTime?
  completedAt      DateTime?
  interviewerName  String?
  interviewerTitle String?
  notes            String?   @db.Text
  prepNotes        String?   @db.Text
  reflection       String?   @db.Text
  outcome          String?   // passed, failed, pending, cancelled
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([jobId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Saved Searches
// ---------------------------------------------------------------------------
// NOTE: The following SavedSearch model has been added and requires `prisma db push`:
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // e.g. "ML Engineer in NYC"
  query     String   // search query text
  location  String?  // location filter
  remoteOnly Boolean @default(false)
  lastRunAt DateTime?
  resultCount Int?   // last known result count
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
