# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secret-here"

# Google OAuth (optional - email/password auth works without this)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JSearch API (optional - job search won't work without this)
RAPIDAPI_KEY=""
RAPIDAPI_HOST="jsearch.p.rapidapi.com"
